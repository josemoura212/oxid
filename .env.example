# Copie para `.env` e ajuste. O `.env` real é gitignored.
#
#   cp .env.example .env

# --- Postgres (consumido pelo infra/docker-compose.yml) ---
POSTGRES_USER=oxid
POSTGRES_PASSWORD=9a7ac8b7ee90314e7e5c326eda6208a5
POSTGRES_DB=oxid
POSTGRES_PORT=5432

# --- Aplicação ---
# Usada pelo sqlx em TEMPO DE COMPILAÇÃO (query_as! valida o SQL contra o schema real)
# e em runtime pelo PgPool. Precisa bater com as variáveis acima.
DATABASE_URL=postgres://oxid:9a7ac8b7ee90314e7e5c326eda6208a5@localhost:5432/oxid

# Porta HTTP da aplicação.
APP_PORT=3000

# Filtro do tracing-subscriber (EnvFilter).
RUST_LOG=oxid=debug,tower_http=debug,info
