# cp .env.example .env
#
# This does not configure the application — that is `configuration/*.yaml`,
# with precedence base.yaml → <APP_ENVIRONMENT>.yaml → APP_*.
# Only what reads environment variables lives here: docker-compose and sqlx
# (compile-time macros + CLI). The values must match the YAML.

POSTGRES_USER=oxid
POSTGRES_PASSWORD=change-me-to-anything-not-local
POSTGRES_DB=oxid
POSTGRES_PORT=5432

DATABASE_URL=postgres://oxid:change-me-to-anything-not-local@localhost:5432/oxid

RUST_LOG=oxid=debug,tower_http=debug,info

# uid/gid the dev containers run as (`id -u` / `id -g`), so bind-mounted files
# keep your ownership instead of turning root-owned.
DOCKER_UID=1000
DOCKER_GID=1000

# APP_ENVIRONMENT=local
# APP_DATABASE__PASSWORD=...
# APP_APPLICATION__PORT=3000
