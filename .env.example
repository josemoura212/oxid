# cp .env.example .env
#
# EN: This does not configure the application — that is `configuration/*.yaml`,
# EN: with precedence base.yaml → <APP_ENVIRONMENT>.yaml → APP_*.
# EN: Only what reads environment variables lives here: docker-compose and sqlx
# EN: (compile-time macros + CLI). The values must match the YAML.
# PT: Não configura a aplicação — isso é `configuration/*.yaml`, com precedência
# PT: base.yaml → <APP_ENVIRONMENT>.yaml → APP_*.
# PT: Aqui só o que lê variável de ambiente: docker-compose e sqlx (macros em
# PT: tempo de compilação + CLI). Os valores precisam bater com o YAML.

POSTGRES_USER=oxid
POSTGRES_PASSWORD=change-me-to-anything-not-local
POSTGRES_DB=oxid
POSTGRES_PORT=5432

DATABASE_URL=postgres://oxid:change-me-to-anything-not-local@localhost:5432/oxid

RUST_LOG=oxid=debug,tower_http=debug,info

# EN: uid/gid the dev containers run as (`id -u` / `id -g`), so bind-mounted files
# EN: keep your ownership instead of turning root-owned.
# PT: uid/gid com que os containers de dev rodam (`id -u` / `id -g`), para arquivos
# PT: no bind mount manterem seu dono em vez de virarem root.
DOCKER_UID=1000
DOCKER_GID=1000

# APP_ENVIRONMENT=local
# APP_DATABASE__PASSWORD=...
# APP_APPLICATION__PORT=3000
