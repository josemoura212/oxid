# cp .env.example .env
#
# This does not configure the application — that is `configuration/*.yaml`,
# with precedence base.yaml → <APP_ENVIRONMENT>.yaml → APP_*.
# Only what reads environment variables lives here: docker-compose and sqlx
# (compile-time macros + CLI). The values must match the YAML.

POSTGRES_USER=oxid
POSTGRES_PASSWORD=change-me-to-anything-not-local
POSTGRES_DB=oxid
POSTGRES_PORT=5432

DATABASE_URL=postgres://oxid:change-me-to-anything-not-local@localhost:5432/oxid

RUST_LOG=oxid=debug,tower_http=debug,info

# uid/gid the dev containers run as (`id -u` / `id -g`), so bind-mounted files
# keep your ownership instead of turning root-owned.
DOCKER_UID=1000
DOCKER_GID=1000

# APP_ENVIRONMENT=local
# APP_DATABASE__PASSWORD=...
# APP_APPLICATION__PORT=3000

# 6379 may be taken by another project; publish somewhere free.
REDIS_PORT=6381

# ClickHouse for click analytics (stage 12). The password must match
# analytics.clickhouse.password in configuration/local.yaml.
CLICKHOUSE_USER=oxid
CLICKHOUSE_PASSWORD=oxid
CLICKHOUSE_DB=oxid
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# Cap ClickHouse's memory — it sizes caches to all of RAM otherwise. Raise on a
# machine with room; keep tight on the shared production node.
CLICKHOUSE_MEM_LIMIT=2g
