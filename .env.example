# cp .env.example .env
#
# Não configura a aplicação — isso é `configuration/*.yaml`, com precedência
# base.yaml → <APP_ENVIRONMENT>.yaml → APP_*.
# Aqui só o que lê variável de ambiente: docker-compose e sqlx (macros em tempo
# de compilação + CLI). Os valores precisam bater com o YAML.

POSTGRES_USER=oxid
POSTGRES_PASSWORD=troque-em-qualquer-coisa-que-nao-seja-local
POSTGRES_DB=oxid
POSTGRES_PORT=5432

DATABASE_URL=postgres://oxid:troque-em-qualquer-coisa-que-nao-seja-local@localhost:5432/oxid

RUST_LOG=oxid=debug,tower_http=debug,info

# APP_ENVIRONMENT=local
# APP_DATABASE__PASSWORD=...
# APP_APPLICATION__PORT=3000
