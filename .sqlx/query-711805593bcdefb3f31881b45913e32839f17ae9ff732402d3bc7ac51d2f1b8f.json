{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT sc.id AS code_id, u.long_url, sc.created_at\n        FROM short_codes sc\n        JOIN urls u ON u.id = sc.url_id\n        WHERE sc.owner_id = $1\n          AND ($2::timestamptz IS NULL\n               OR (sc.created_at, sc.id) < ($2::timestamptz, $3::bigint))\n        ORDER BY sc.created_at DESC, sc.id DESC\n        LIMIT $4\n        ",
