{
  "manifest_version": 3,
  "name": "oxid",
  "version": "0.1.0",
  "description": "Um clique encurta a página aberta e copia o link curto.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": ["https://oxid.uk/*"],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "oxid@oxid.uk",
      "strict_min_version": "115.0"
    }
  },

  "action": {
    "default_title": "Encurtar esta página com oxid",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
