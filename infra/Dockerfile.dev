# Development image only — hot reload with the source bind-mounted from the
# host. Production build comes in Stage 8 (multi-stage, slim runtime).
FROM rust:1.97-bookworm

RUN rustup target add wasm32-unknown-unknown

# binstall pulls prebuilt binaries; `cargo install` would compile these from
# source and add ~10 minutes to the image build.
RUN curl -fsSL https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y --install-path /usr/local/bin \
    watchexec-cli \
    trunk \
    wasm-bindgen-cli \
    && rm -rf /usr/local/cargo/registry

# CARGO_HOME outside the image default so the container can run as the host
# user (UID 1000) without permission errors on the registry cache.
ENV CARGO_HOME=/cargo
# a named volume inherits the permissions of the path it shadows in the image.
# Without creating these world-writable first, the volume comes up root-owned
# and the non-root container cannot write to it.
RUN mkdir -p /cargo /target && chmod 777 /cargo /target

WORKDIR /app
