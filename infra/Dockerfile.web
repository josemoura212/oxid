# Front end image: trunk compiles the Leptos app to WebAssembly, nginx serves it.
#
# Separate from the API on purpose. The two change at completely different rates,
# and bundling them would mean a full Rust release build (~4 min) to alter a line
# of CSS. nginx also serves static files far better than a hand-rolled handler:
# brotli, cache headers and sendfile come for free.

FROM rust:1.97-bookworm AS builder

RUN rustup target add wasm32-unknown-unknown

RUN curl -fsSL https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y --install-path /usr/local/bin trunk wasm-bindgen-cli

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates crates

WORKDIR /build/crates/oxid-web

# `--public-url /assets/` is what keeps the two namespaces apart: the API matches
# `/{code}` on any single-segment path, so a root-level `oxid-web-abc.wasm` would
# be read as a shortcode. Under `/assets/` there is no overlap at all.
RUN trunk build --release --public-url /assets/

# ---

FROM nginx:1.29-alpine

COPY --from=builder /build/crates/oxid-web/dist /usr/share/nginx/html
COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
