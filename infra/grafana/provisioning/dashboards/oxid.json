{
  "uid": "oxid-overview",
  "title": "oxid — overview",
  "tags": ["oxid"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Read latency (p50 / p95 / p99)",
      "description": "Stage 10 targets p95 under 50 ms on the redirect. Quantiles come from the histogram buckets, so they are as precise as the bucket edges — not exact values.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{route}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second, by status",
      "description": "Any sustained 5xx is a failed run: stage 9's acceptance is zero errors, not few errors.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Positive hits over all lookups. The original study settled at 50% by caching only a top-100 ranking; caching every miss is what this number is meant to prove.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(cache_lookups_total{outcome=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(cache_lookups_total[$__rate_interval])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache lookups by outcome",
      "description": "hit / miss / hit_negative. A rising hit_negative means someone is walking codes that do not exist.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(cache_lookups_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Postgres pool connections",
      "description": "Busy is total minus idle. Busy pinned at max_connections means requests are queueing on the pool, not on the database — the failure the acquire timeout turns into an error instead of a hang.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "db_pool_connections{state=\"total\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "db_pool_connections{state=\"idle\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "db_pool_connections{state=\"total\"} - db_pool_connections{state=\"idle\"}",
          "legendFormat": "busy",
          "refId": "C"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
